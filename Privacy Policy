<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Privacy Policy — OnBase</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #f4f5f7;
    --card: #ffffff;
    --card-border: #dfe2e8;
    --text: #1e293b;
    --text-muted: #64748b;
    --accent: #ff6900;
    --accent-dim: #e05e00;
    --focus: rgba(255,105,0,0.18);
  }

  *{ box-sizing: border-box; }

  html{ scroll-behavior: smooth; }

  body{
    margin: 0;
    background: var(--bg);
    font-family: 'Inter', -apple-system, sans-serif;
    color: var(--text);
    min-height: 100vh;
  }

  a{ color: var(--accent-dim); }

  /* Top bar */
  header.brand{
    max-width: 1180px;
    margin: 0 auto;
    padding: 28px 24px 20px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--card-border);
  }

  .brand-mark{
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
  }

  .brand-tag{
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  /* Hero */
  .hero{
    max-width: 1180px;
    margin: 0 auto;
    padding: 56px 24px 0;
  }

  .eyebrow{
    color: var(--accent-dim);
    font-size: 0.9rem;
    font-weight: 500;
    margin: 0 0 14px 0;
  }

  h1{
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.2rem, 4.5vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 16px 0;
    letter-spacing: -0.01em;
  }

  .hero-sub{
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 640px;
    margin: 0 0 8px 0;
  }

  .updated{
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  /* Layout */
  .wrapper{
    max-width: 1180px;
    margin: 0 auto;
    padding: 48px 24px 80px;
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 56px;
    align-items: start;
  }

  @media (max-width: 880px){
    .wrapper{ grid-template-columns: 1fr; gap: 32px; }
    .hero{ padding: 40px 20px 0; }
    header.brand{ padding: 22px 20px 16px; }
  }

  /* Sidebar nav */
  nav.toc{
    position: sticky;
    top: 28px;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 22px;
  }

  @media (max-width: 880px){
    nav.toc{ position: static; }
  }

  .toc-title{
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0 0 14px 0;
  }

  nav.toc ol{
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    counter-reset: toc;
  }

  nav.toc li{ counter-increment: toc; }

  nav.toc a{
    display: block;
    padding: 7px 8px;
    border-radius: 6px;
    font-size: 0.88rem;
    color: var(--text);
    text-decoration: none;
    line-height: 1.4;
  }

  nav.toc a::before{
    content: counter(toc) ".  ";
    color: var(--text-muted);
  }

  nav.toc a:hover{
    background: #f8f5f2;
    color: var(--accent-dim);
  }

  nav.toc a.active{
    background: #fff1e6;
    color: var(--accent-dim);
    font-weight: 600;
  }

  nav.toc a.active::before{
    color: var(--accent-dim);
  }

  /* Document */
  .doc{
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 44px;
    box-shadow: 0 20px 40px rgba(30,41,59,0.06);
  }

  @media (max-width: 560px){
    .doc{ padding: 28px 22px; }
  }

  .doc > p.lede{
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin: 0 0 20px 0;
  }

  .doc > p.lede + p.lede{ margin-top: -8px; }

  section{
    margin-bottom: 40px;
    padding-top: 8px;
    scroll-margin-top: 28px;
  }

  section:last-of-type{ margin-bottom: 0; }

  section h2{
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0 0 14px 0;
    padding-top: 20px;
    border-top: 1px solid var(--card-border);
  }

  section:first-of-type h2{ border-top: none; padding-top: 0; }

  section h3{
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.02rem;
    font-weight: 700;
    margin: 22px 0 8px 0;
