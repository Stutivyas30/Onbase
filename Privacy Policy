  .contact-block{
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.98rem;
  }

  .contact-block strong{ font-weight: 600; }

  /* Footer */
  footer.foot{
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px 24px 48px;
    border-top: 1px solid var(--card-border);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  footer.foot a{ color: var(--text-muted); }
  footer.foot a:hover{ color: var(--accent-dim); }

  /* back to top */
  .top-link{
    display: inline-block;
    margin-top: 28px;
    font-size: 0.85rem;
    color: var(--accent-dim);
    text-decoration: none;
  }
</style>
