  <script>
    (function(){
      var toc = document.getElementById('toc');
      var sections = Array.prototype.slice.call(document.querySelectorAll('.doc section[id]'));

      /* Build the table of contents from the sections so it never drifts out of sync */
      var list = document.createElement('ol');
      var linkById = {};
      sections.forEach(function(sec){
        var title = sec.querySelector('h2').textContent.replace(/^\d+\.\s*/, '');
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = '#' + sec.id;
        a.textContent = title;
        li.appendChild(a);
        list.appendChild(li);
        linkById[sec.id] = a;
      });
      toc.appendChild(list);

      /* On small screens the contents start collapsed; on desktop they stay open */
      var small = window.matchMedia('(max-width: 940px)');
      function syncToc(){
        if(small.matches){ toc.removeAttribute('open'); }
        else{ toc.setAttribute('open', ''); }
      }
      syncToc();
      if(small.addEventListener){ small.addEventListener('change', syncToc); }
      toc.querySelector('summary').addEventListener('click', function(e){
        if(!small.matches){ e.preventDefault(); }
      });
      list.addEventListener('click', function(){
        if(small.matches){ toc.removeAttribute('open'); }
      });

      /* Highlight the section currently being read */
      var current = null;
      function setActive(id){
        if(id === current) return;
        current = id;
        Object.keys(linkById).forEach(function(key){
          linkById[key].classList.toggle('active', key === id);
        });
      }
      function update(){
        var id = sections[0].id;
        sections.forEach(function(sec){
          if(sec.getBoundingClientRect().top <= 140) id = sec.id;
        });
        setActive(id);
      }
      var ticking = false;
      window.addEventListener('scroll', function(){
        if(ticking) return;
        ticking = true;
        requestAnimationFrame(function(){ update(); ticking = false; });
      }, { passive: true });
      update();
    })();
  </script>

