<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Privacy Policy — OnBase</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --slate: #1e293b;
    --slate-deep: #162032;
    --orange: #ff6f00;
    --orange-hover: #ff8526;
    --orange-text: #c25400;      /* orange dark enough for text on light */

    --page: #f4f5f7;
    --white: #ffffff;
    --ink: #1e293b;
    --ink-muted: #5b6678;
    --line: #e0e4ea;

    --on-dark: #f1f5f9;
    --on-dark-muted: #a3b0c2;
    --line-dark: rgba(255,255,255,0.14);
  }

  *{ box-sizing: border-box; }
  html{ scroll-behavior: smooth; }

  body{
    margin: 0;
    background: var(--page);
    font-family: 'Inter', -apple-system, sans-serif;
    color: var(--ink);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }

  a{ color: var(--orange-text); }
  .wrapper{ max-width: 1180px; margin: 0 auto; padding: 0 24px; }

  /* =========================================================
     HERO  (slate)
     ========================================================= */
  .hero{
    background: var(--slate);
    color: var(--on-dark);
    position: relative;
    overflow: hidden;
  }
  .hero-media{ position: absolute; inset: 0; z-index: 0; }
  .hero-media video{ width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-media::after{
    content: "";
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(30,41,59,0.95) 0%, rgba(30,41,59,0.80) 55%, rgba(30,41,59,0.62) 100%);
  }
  .hero > *:not(.hero-media){ position: relative; z-index: 1; }

  .nav .wrapper{
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
    gap: 24px;
  }
  .brand-mark{
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--on-dark);
  }
  .brand-mark span{ color: var(--orange); }

  .nav-links{ display: flex; gap: 30px; }
  .nav-links a{
    font-size: 0.92rem;
    color: var(--on-dark-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav-links a:hover{ color: #fff; }

  .btn-nav{
    background: var(--orange);
    color: var(--slate);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 10px 20px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s ease;
    white-space: nowrap;
  }
  .btn-nav:hover{ background: var(--orange-hover); }
  .btn-nav:focus-visible, .nav-links a:focus-visible, .brand-mark:focus-visible{
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .hero-body{
    padding: 56px 0 120px;
    max-width: 700px;
  }
  h1{
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.6rem, 5.4vw, 3.9rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0 0 20px 0;
  }
  h1 em{ font-style: italic; color: var(--orange); }

  .hero-sub{
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--on-dark-muted);
    margin: 0 0 22px 0;
    max-width: 560px;
  }
  .updated{
    display: inline-block;
    font-size: 0.85rem;
    color: var(--on-dark);
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    padding: 6px 14px;
    margin: 0;
  }

  /* =========================================================
     SHORT VERSION  (overlaps hero edge)
     ========================================================= */
  .summary{ position: relative; z-index: 2; margin-top: -52px; }
  .summary-bar{
    display: grid;
    grid-template-columns: 0.8fr 1fr 1fr 1fr;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(30,41,59,0.10);
  }
  .sum-cell{ padding: 24px 26px; }
  .sum-cell + .sum-cell{ border-left: 1px solid var(--line); }
  .sum-lead{
    display: flex;
    align-items: center;
  }
  .sum-lead p{
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .sum-title{
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    margin: 0 0 6px 0;
  }
  .sum-text{
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-muted);
    margin: 0;
  }

  /* =========================================================
     DOCUMENT LAYOUT
     ========================================================= */
  .layout{
    display: grid;
    grid-template-columns: 260px minmax(0, 740px);
    justify-content: start;
    gap: 56px;
    align-items: start;
    padding-top: 64px;
  }

  /* Table of contents */
  nav.toc{
    position: sticky;
    top: 24px;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px 18px;
  }
  nav.toc summary{
    list-style: none;
    cursor: default;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
    padding: 0 8px 12px;
  }
  nav.toc summary::-webkit-details-marker{ display: none; }
  nav.toc ol{
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    counter-reset: toc;
  }
  nav.toc li{ counter-increment: toc; }
  nav.toc a{
    display: block;
    padding: 7px 8px;
    border-radius: 8px;
    font-size: 0.88rem;
    color: var(--ink-muted);
    text-decoration: none;
    line-height: 1.4;
    transition: background 0.15s ease, color 0.15s ease;
  }
  nav.toc a::before{
    content: counter(toc) ".  ";
    color: #98a2b3;
  }
  nav.toc a:hover{ background: var(--page); color: var(--ink); }
  nav.toc a.active{
    background: rgba(255,111,0,0.10);
    color: var(--orange-text);
    font-weight: 600;
  }
  nav.toc a.active::before{ color: var(--orange-text); }
  nav.toc a:focus-visible{ outline: 2px solid var(--ink); outline-offset: 2px; }

  /* Document card */
  .doc{
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 48px;
    box-shadow: 0 24px 48px rgba(30,41,59,0.07);
  }

  .doc > p.lede{
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--ink-muted);
    margin: 0 0 18px 0;
  }
  .doc > p.lede:first-child{
    font-size: 1.12rem;
    color: var(--ink);
  }
  .doc > p.lede:last-of-type{ margin-bottom: 44px; }

  section{
    margin-bottom: 40px;
    scroll-margin-top: 24px;
  }
  section:last-of-type{ margin-bottom: 0; }

  section h2{
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 14px 0;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  section h3{
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.02rem;
    font-weight: 700;
    margin: 24px 0 8px 0;
  }

  section p{
    font-size: 1rem;
    line-height: 1.72;
    color: var(--ink);
    margin: 0 0 12px 0;
  }

  section ul{
    margin: 0 0 14px 0;
    padding-left: 22px;
  }
  section li{
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink);
    margin-bottom: 5px;
  }
  section li::marker{ color: var(--orange); }

  .note{
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--ink);
    background: var(--page);
    border-left: 3px solid var(--orange);
    border-radius: 4px 10px 10px 4px;
    padding: 14px 18px;
    margin: 6px 0 14px 0;
  }

  .contact-block{
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 1rem;
    background: var(--page);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px 20px;
  }
  .contact-block strong{ font-weight: 600; }

  .top-link{
    display: inline-block;
    margin-top: 32px;
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
  }
  .top-link:hover{ text-decoration: underline; }

  /* =========================================================
     FOOTER  (slate)
     ========================================================= */
  footer.foot{
    margin-top: 96px;
    background: var(--slate);
    color: var(--on-dark);
  }
  footer.foot .wrapper{
    padding-top: 40px;
    padding-bottom: 34px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .foot-top{
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .foot-tag{
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
    font-size: 1.1rem;
    margin: 0;
  }
  .foot-links{ display: flex; flex-wrap: wrap; gap: 22px; }
  .foot-links a{
    font-size: 0.9rem;
    color: var(--on-dark-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .foot-links a:hover{ color: var(--orange); }
  .foot-copy{
    font-size: 0.85rem;
    color: var(--on-dark-muted);
    margin: 0;
    padding-top: 22px;
    border-top: 1px solid var(--line-dark);
  }

  /* =========================================================
     RESPONSIVE
     ========================================================= */
  @media (max-width: 1020px){
    .summary-bar{ grid-template-columns: 1fr 1fr; }
    .sum-cell + .sum-cell{ border-left: 0; }
    .sum-cell:nth-child(even){ border-left: 1px solid var(--line); }
    .sum-cell:nth-child(n+3){ border-top: 1px solid var(--line); }
    .sum-lead{ grid-column: 1 / -1; }
    .sum-lead + .sum-cell{ border-top: 1px solid var(--line); border-left: 0; }
    .sum-lead ~ .sum-cell:nth-child(3){ border-left: 1px solid var(--line); border-top: 1px solid var(--line); }
    .sum-lead ~ .sum-cell:nth-child(4){ grid-column: 1 / -1; border-left: 0; border-top: 1px solid var(--line); }
  }

  @media (max-width: 940px){
    .nav-links{ display: none; }
    .hero-body{ padding: 36px 0 108px; }
    .layout{ grid-template-columns: minmax(0, 1fr); gap: 28px; padding-top: 44px; }
    nav.toc{ position: static; max-height: none; overflow: visible; }
    nav.toc summary{
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 0;
    }
    nav.toc summary::after{
      content: "";
      width: 8px; height: 8px;
      border-right: 2px solid var(--ink-muted);
      border-bottom: 2px solid var(--ink-muted);
      transform: rotate(45deg);
      margin-right: 4px;
      transition: transform 0.15s ease;
    }
    nav.toc details[open] summary{ padding-bottom: 12px; }
    nav.toc details[open] summary::after{ transform: rotate(-135deg); }
  }

  @media (max-width: 560px){
    .wrapper{ padding: 0 20px; }
    .doc{ padding: 28px 20px; }
    .summary-bar{ grid-template-columns: 1fr; }
    .sum-cell{ padding: 20px; }
    .sum-cell + .sum-cell,
    .sum-cell:nth-child(even),
    .sum-lead ~ .sum-cell:nth-child(3),
    .sum-lead ~ .sum-cell:nth-child(4){
      grid-column: auto;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .sum-lead{ grid-column: auto; }
  }

  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior: auto; }
    .hero-media video{ display: none; }
    *{ transition: none !important; }
  }
</style>
</head>
